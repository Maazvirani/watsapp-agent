# Application Server Settings
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Gemini AI API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Meta WhatsApp Business Cloud API Configuration
META_WHATSAPP_TOKEN=YOUR_META_WHATSAPP_ACCESS_TOKEN
META_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
META_VERIFY_TOKEN=whatsapp_ai_verify_secret_123

# Email Connection (Gmail / SMTP)
GMAIL_USER=yourbusiness@gmail.com
GMAIL_PASS=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Google Sheets Integration
GOOGLE_SHEETS_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Prototype Draft Mode (Set to true to test full flow via Web Simulator without API keys)
ENABLE_MOCK_MODE=true
